+SD_API sd_image_t* sd_decode_latents(sd_ctx_t* sd_ctx,
+                                     const char* latents_path,
+                                     bool vae_space,
+                                     bool tiling,
+                                     int tile_size,
+                                     int* num_images) {
+    if (sd_ctx == nullptr || sd_ctx->sd == nullptr || latents_path == nullptr) {
+        return nullptr;
+    }
+    // Tiling normally arrives with the request; there is no request here, so set
+    // it on the context, exactly as generate_image would have.
+    sd_tiling_params_t tiling_params = {false, false, 0, 0, 0.5f, 0, 0, nullptr};
+    tiling_params.enabled            = tiling;
+    if (tile_size > 0) {
+        tiling_params.tile_size_w = tile_size;
+        tiling_params.tile_size_h = tile_size;
+    }
+    sd_ctx->sd->vae_tiling_params = tiling_params;
+    sd::Tensor<float> decoded = sd_ctx->sd->decode_latents_file(latents_path, vae_space);
+    if (decoded.empty()) {
+        LOG_ERROR("sd_decode_latents: decode failed for %s", latents_path);
+        return nullptr;
+    }
+    sd_image_t* images = (sd_image_t*)calloc(1, sizeof(sd_image_t));
+    if (images == nullptr) {
+        return nullptr;
+    }
+    images[0] = tensor_to_sd_image(decoded);
+    if (num_images != nullptr) {
+        *num_images = 1;
+    }
+    return images;
+}
