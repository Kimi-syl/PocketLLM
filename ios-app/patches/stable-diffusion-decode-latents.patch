+sd::Tensor<float> StableDiffusionGGML::decode_latents_file(const std::string& path, bool vae_space) {
+    if (first_stage_model == nullptr) {
+        LOG_ERROR("decode_latents: this context has no VAE");
+        return {};
+    }
+    FILE* file = std::fopen(path.c_str(), "rb");
+    if (file == nullptr) {
+        LOG_ERROR("decode_latents: cannot open %s", path.c_str());
+        return {};
+    }
+    // The blob is the dump hook's own format: magic, version, ndim, one i32 per
+    // dimension in the tensor's shape order (the fastest axis first, which is
+    // this Tensor's shape()[0]), then contiguous f32.
+    uint32_t magic        = 0;
+    int32_t blob_version  = 0;
+    int32_t ndim          = 0;
+    bool ok = std::fread(&magic, sizeof(magic), 1, file) == 1 &&
+              std::fread(&blob_version, sizeof(blob_version), 1, file) == 1 &&
+              std::fread(&ndim, sizeof(ndim), 1, file) == 1 &&
+              magic == 0x564C4C50u && blob_version == 1 && ndim >= 3 && ndim <= 5;
+    std::vector<int64_t> shape;
+    int64_t count = 1;
+    for (int32_t d = 0; ok && d < ndim; d++) {
+        int32_t dim = 0;
+        ok = std::fread(&dim, sizeof(dim), 1, file) == 1 && dim > 0;
+        if (ok) {
+            shape.push_back(dim);
+            count *= dim;
+        }
+    }
+    std::vector<float> data;
+    if (ok) {
+        data.resize(static_cast<size_t>(count));
+        ok = std::fread(data.data(), sizeof(float), static_cast<size_t>(count), file) == static_cast<size_t>(count);
+    }
+    std::fclose(file);
+    if (!ok) {
+        LOG_ERROR("decode_latents: %s is not a readable latent blob", path.c_str());
+        return {};
+    }
+    sd::Tensor<float> latents(std::move(shape), std::move(data));
+    LOG_INFO("decode_latents: %s %lld element(s), %s space", path.c_str(),
+             (long long)latents.numel(), vae_space ? "VAE" : "sampler");
+    return vae_space ? decode_vae_latents(latents, false) : decode_first_stage(latents, false);
+}
